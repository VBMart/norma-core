<?xml version="1.0"?>
<!-- NC lamp, generated by cad/build_lamp.py export_urdf(). Meshes in mm (scale 0.001), each in its link frame. -->
<robot name="nc_lamp">
  <material name="dark"><color rgba="0.22 0.22 0.24 1.00"/></material>
  <material name="white"><color rgba="0.92 0.92 0.90 1.00"/></material>
  <material name="clear"><color rgba="0.80 0.90 1.00 0.35"/></material>
  <material name="servo"><color rgba="0.08 0.08 0.08 1.00"/></material>
  <link name="base_link">
    <visual name="base_cup"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/base_cup.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="base_cup"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/base_cup.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="base_bottom"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/base_bottom.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="base_bottom"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/base_bottom.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="servo_S1"><origin xyz="0.000000 0.000000 0.041380" rpy="1.570796 -0.000000 0.000000"/><geometry><mesh filename="meshes/st3215.stl" scale="0.001 0.001 0.001"/></geometry><material name="servo"/></visual>
    <inertial><origin xyz="-0.000054 -0.000045 0.022296" rpy="0 0 0"/><mass value="0.8963"/><inertia ixx="2.181e-03" ixy="0" ixz="0" iyy="2.181e-03" iyz="0" izz="3.824e-03"/></inertial>
  </link>
  <link name="turntable">
    <visual name="turntable"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/turntable.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="turntable"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/turntable.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="tower_lid"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/tower_lid.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="tower_lid"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/tower_lid.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="servo_S2"><origin xyz="-0.031000 0.000000 0.108010" rpy="0.000000 -1.570796 0.000000"/><geometry><mesh filename="meshes/st3215.stl" scale="0.001 0.001 0.001"/></geometry><material name="servo"/></visual>
    <inertial><origin xyz="-0.020913 -0.001082 0.090498" rpy="0 0 0"/><mass value="0.1653"/><inertia ixx="2.267e-04" ixy="0" ixz="0" iyy="2.267e-04" iyz="0" izz="3.334e-04"/></inertial>
  </link>
  <link name="upper_arm">
    <visual name="link_upper"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/link_upper.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="link_upper"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/link_upper.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="plate_shoulder"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/plate_shoulder.stl" scale="0.001 0.001 0.001"/></geometry><material name="white"/></visual>
    <collision name="plate_shoulder"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/plate_shoulder.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="lid_upper"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/lid_upper.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="lid_upper"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/lid_upper.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="servo_S3"><origin xyz="0.130000 0.005000 0.000000" rpy="0.000000 -0.000000 0.000000"/><geometry><mesh filename="meshes/st3215.stl" scale="0.001 0.001 0.001"/></geometry><material name="servo"/></visual>
    <inertial><origin xyz="0.083660 -0.000819 0.000103" rpy="0 0 0"/><mass value="0.2014"/><inertia ixx="3.499e-04" ixy="0" ixz="0" iyy="8.031e-04" iyz="0" izz="5.883e-04"/></inertial>
  </link>
  <link name="forearm">
    <visual name="link_fore"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/link_fore.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="link_fore"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/link_fore.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="plate_elbow"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/plate_elbow.stl" scale="0.001 0.001 0.001"/></geometry><material name="white"/></visual>
    <collision name="plate_elbow"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/plate_elbow.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="lid_fore"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/lid_fore.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="lid_fore"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/lid_fore.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="servo_S4"><origin xyz="0.130000 0.005000 0.000000" rpy="0.000000 -0.000000 0.000000"/><geometry><mesh filename="meshes/st3215.stl" scale="0.001 0.001 0.001"/></geometry><material name="servo"/></visual>
    <inertial><origin xyz="0.083660 -0.000819 0.000103" rpy="0 0 0"/><mass value="0.2014"/><inertia ixx="8.932e-05" ixy="0" ixz="0" iyy="4.842e-04" iyz="0" izz="5.301e-04"/></inertial>
  </link>
  <link name="neck">
    <visual name="neck"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/neck.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="neck"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/neck.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="plate_wrist"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/plate_wrist.stl" scale="0.001 0.001 0.001"/></geometry><material name="white"/></visual>
    <collision name="plate_wrist"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/plate_wrist.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="cap"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/cap.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="cap"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/cap.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><origin xyz="0.027443 -0.008717 0.000000" rpy="0 0 0"/><mass value="0.0819"/><inertia ixx="9.234e-05" ixy="0" ixz="0" iyy="1.305e-04" iyz="0" izz="9.309e-05"/></inertial>
  </link>
  <link name="head">
    <visual name="shade"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/shade.stl" scale="0.001 0.001 0.001"/></geometry><material name="white"/></visual>
    <collision name="shade"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/shade.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="bezel"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/bezel.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark"/></visual>
    <collision name="bezel"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/bezel.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="disc"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/disc.stl" scale="0.001 0.001 0.001"/></geometry><material name="clear"/></visual>
    <collision name="disc"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/disc.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="plate"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/plate.stl" scale="0.001 0.001 0.001"/></geometry><material name="white"/></visual>
    <collision name="plate"><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/plate.stl" scale="0.001 0.001 0.001"/></geometry></collision>
    <visual name="servo_S5"><origin xyz="0.000000 -0.000000 -0.000000" rpy="-1.570796 1.570796 0.000000"/><geometry><mesh filename="meshes/st3215.stl" scale="0.001 0.001 0.001"/></geometry><material name="servo"/></visual>
    <inertial><origin xyz="0.003211 -0.000145 -0.027129" rpy="0 0 0"/><mass value="0.2054"/><inertia ixx="1.045e-03" ixy="0" ixz="0" iyy="1.570e-03" iyz="0" izz="9.922e-04"/></inertial>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/><child link="turntable"/>
    <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.570796" upper="1.570796" effort="2.0" velocity="3.0"/>
    <!-- default pose 0.0 deg -->
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="turntable"/><child link="upper_arm"/>
    <origin xyz="-0.031000 0.000000 0.108010" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.610865" upper="1.832596" effort="2.0" velocity="3.0"/>
    <!-- default pose 70.0 deg -->
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0.130000 0.005000 0.000000" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.396263" upper="0.698132" effort="2.0" velocity="3.0"/>
    <!-- default pose -70.0 deg -->
  </joint>
  <joint name="wrist" type="revolute">
    <parent link="forearm"/><child link="neck"/>
    <origin xyz="0.130000 0.005000 0.000000" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.523599" upper="1.745329" effort="2.0" velocity="3.0"/>
    <!-- default pose 40.0 deg -->
  </joint>
  <joint name="head_roll" type="revolute">
    <parent link="neck"/><child link="head"/>
    <origin xyz="0.075300 -0.010000 0.000000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.396263" upper="1.396263" effort="2.0" velocity="3.0"/>
    <!-- default pose 0.0 deg -->
  </joint>
</robot>
